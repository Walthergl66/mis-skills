# Normalize text files to LF in the repository and in checkouts.
# Prevents CRLF churn when scripts regenerate docs/SKILLS.md or the skills mirror.
* text=auto eol=lf

*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.sh text eol=lf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
